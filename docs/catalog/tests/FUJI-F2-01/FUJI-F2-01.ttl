<https://w3id.org/FAIROS/test/FUJI-F2-01> a ftr:Test ;
    dcterms:identifier <https://w3id.org/FAIROS/test/FUJI-F2-01> ;
    dcterms:title "Core data citation metadata is available"^^xsd:string ;
    rdfs:label "FUJI-F2-01"^^xsd:string ;
    vivo:abbreviation "FUJI-F2-01"^^xsd:string ;
    dcterms:description """This test resolves the DOI and attempts to retrieve and analyze the core data citation metadata from both the DOI landing page and its target HTML page. Multiple metadata standards are checked, including schema.org (JSON-LD), Dublin Core, OpenGraph, Highwire/eprints, and RDFa.
    The core metadata elements include creator, title, object identifier, publication date, publisher, and object type.
    
    Source: Since FAIROS uses [F-UJI](https://f-uji.net) to assess a Research Object, this test is an instance of the test **FsF-F2-01M-2**. You can find more information in the european project FAIR IMPACT(https://fair-impact.eu/metrics-data)"""^^xsd:string ;
    dcat:keyword "metadata"@en , "web"@en , "standard"@en ;
    dcat:theme  <http://www.fairsharing.org/ontology/subject/SRAO_0000401>; 
    dcat:version "0.0.1"^^xsd:string ;
    
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    ftr:status "Active"@en ;
    
    
    
    ftr:supportedBy  <https://www.f-uji.net/>; 
    dpv:IsApplicableFor ro:ROCrate;
    dcterms:creator <https://ror.org/03n6nwv02> ;
    dcterms:publisher <https://oeg.fi.upm.es>, <https://ror.org/03n6nwv02> ;
    
    dcat:contactPoint <https://orcid.org/0000-0003-4112-6825>  .    

<https://orcid.org/0000-0003-4112-6825> a vcard:Individual ;
    vcard:fn "Esteban Gonzalez"^^xsd:string ;
    vcard:hasEmail <mailto:egonzalez@fi.upm.es> . 

